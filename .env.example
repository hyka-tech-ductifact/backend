# Application settings
BACKEND_HOST=localhost
BACKEND_PORT=8080

# CORS allowed origins (comma-separated)
# Use appropriate origins for your frontend in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT secret key for signing tokens (required — generate with: openssl rand -base64 32)
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_ACCESS_TOKEN_TTL_SECONDS=900 # 15 min
JWT_REFRESH_TOKEN_TTL_SECONDS=604800 # 7 days

# Logging
# Level: debug, info, warn, error (default: info)
LOG_LEVEL=debug
# Format: text (human-readable) or json (machine-parseable, use in production)
LOG_FORMAT=text

# Gin mode: debug (default) or release (production)
GIN_MODE=debug

# Database Configuration
# Use DB_HOST=localhost when running app locally (make app-start)
# Use DB_HOST=postgres when running in Docker
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=microservice_db

# Rate limiting (required — no defaults)
# Use generous values for dev/test; stricter values in production (e.g. 100 req/min per IP).
RATE_LIMIT_IP_MAX=10000
RATE_LIMIT_IP_WINDOW_SECONDS=60
RATE_LIMIT_USER_MAX=10000
RATE_LIMIT_USER_WINDOW_SECONDS=60

# Login throttle (required — no defaults)
LOGIN_THROTTLE_MAX_ATTEMPTS=100
LOGIN_THROTTLE_WINDOW_SECONDS=60
LOGIN_THROTTLE_LOCKOUT_SECONDS=60

# MinIO (S3-compatible object storage for images)
# Use MINIO_HOST=localhost when running app locally
# Use MINIO_HOST=minio when running in Docker
# Use MINIO_USE_SSL=false when running locally without SSL; set to true in production with proper SSL setup.
MINIO_HOST=localhost
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=ductifact
MINIO_USE_SSL=false

# SMTP / Email
# In development, defaults point to MailPit (local SMTP server in docker-compose).
# In production, set SMTP_AUTH=true and use your real provider (SendGrid, SES, etc.).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_USERNAME=noop
SMTP_PASSWORD=noop
SMTP_FROM=noreply@ductifact.com

# One-time OTP codes (registration, password reset)
# Numeric codes are sent by email; TTLs control how long each code is valid.
# The registration TTL also limits account-exists notices to one per address per window.
VERIFICATION_REGISTRATION_OTP_TTL_SECONDS=900 # 15 min
VERIFICATION_PASSWORD_RESET_OTP_TTL_SECONDS=900 # 15 min

# Redis (distributed state: token blacklist, rate limiting, login throttling)
# Redis is always the primary backend. If unavailable at runtime, the system
# degrades gracefully to in-memory adapters.
# Use REDIS_HOST=localhost when running app locally
# Use REDIS_HOST=redis when running in Docker
# In production, set REDIS_AUTH=true and configure REDIS_PASSWORD.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_AUTH=false
REDIS_PASSWORD=noop
REDIS_DB=0
